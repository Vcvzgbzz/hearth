{
  "name": "@vcvzgbzz/hearth",
  "version": "1.1.0",
  "description": "A queue in front of your local inference server, and an optional way to lend the spare capacity to someone you trust.",
  "type": "module",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Vcvzgbzz/hearth.git"
  },
  "bugs": {
    "url": "https://github.com/Vcvzgbzz/hearth/issues"
  },
  "homepage": "https://github.com/Vcvzgbzz/hearth#readme",
  "keywords": [
    "llm",
    "inference",
    "queue",
    "scheduler",
    "llama-swap",
    "openai-compatible",
    "proxy",
    "gpu"
  ],
  "engines": {
    "node": ">=20"
  },
  "bin": {
    "hearth": "dist/cli.js"
  },
  "main": "dist/index.js",
  "types": "dist/index.d.ts",
  "files": [
    "dist",
    "README.md"
  ],
  "scripts": {
    "build": "npm run build:console && tsc",
    "prepare": "npm run build:console && tsc",
    "prepublishOnly": "npm run typecheck && npm test && npm run build",
    "typecheck": "tsc -p tsconfig.test.json && tsc -p tsconfig.ui.json",
    "pretest": "npm run build:console",
    "dev": "tsx src/cli.ts serve",
    "test": "for f in test/*.test.ts; do tsx $f || exit 1; done",
    "build:console": "tailwindcss -i src/console/app.css -o dist/console.css --minify && esbuild src/console/main.tsx --bundle --minify --format=iife --target=es2022 --tsconfig=tsconfig.ui.json --define:process.env.NODE_ENV=\\\"production\\\" --outfile=dist/console.js"
  },
  "dependencies": {
    "yaml": "^2.5.0"
  },
  "devDependencies": {
    "@tailwindcss/cli": "^4.3.3",
    "@types/node": "^22.20.1",
    "@types/react": "^19.2.18",
    "@types/react-dom": "^19.2.4",
    "@xyflow/react": "^12.12.0",
    "esbuild": "^0.28.2",
    "lucide-react": "^1.52.0",
    "react": "^19.2.8",
    "react-dom": "^19.2.8",
    "tailwindcss": "^4.3.3",
    "tsx": "^4.19.0",
    "typescript": "^5.6.0",
    "zustand": "^5.0.15"
  },
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    },
    "./package.json": "./package.json"
  }
}
